# ─── Email Notification (Resend) ───────────────────────────
# Sign up at https://resend.com (free tier: 100 emails/day)
# Get your API key from: https://resend.com/api-keys

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email(s) that receive RSVP notifications (comma-separated)
NOTIFICATION_EMAIL=your-email@example.com,partner-email@example.com

# ─── QR Code Signing Secret ───────────────────────────────
# Used to HMAC-sign QR payloads so they can be verified at the door
QR_SECRET=your-random-secret-here

# ─── Admin Key (for GET /api/rsvp to retrieve guest list) ─
ADMIN_KEY=your-admin-secret-here

# ─── Upstash Redis (RSVP persistence + duplicate check) ───
# Create free DB at https://console.upstash.com
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-token-here

# ─── Origin Validation (optional, comma-separated) ────────
# Leave empty to allow all origins (good for development)
# ALLOWED_ORIGINS=https://your-domain.vercel.app
